// Santa's Stock — Prisma schema
// Based on §5 of inventory-app-feature-research.pdf
//
// Phase 1 includes the core tables; Phase 2+ adds kits, allocations,
// vehicles, maintenance, etc. They're all defined here so migrations
// stay coherent, but only a subset is wired into the UI in Phase 1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  ADMIN
  MANAGER
  USER
}

enum LifecycleType {
  RENTAL_SEASONAL
  SOLD_PERMANENT
  INSTALLED_YEAR_ROUND
}

// Product type for Item — Christmas decor, landscape lighting, or
// permanent year-round lighting/fixtures.
enum ProductType {
  CHRISTMAS
  LANDSCAPE
  PERMANENT
}

// ConditionGrade is kept in the schema (used by ReplacementQueue and other
// models) but no longer surfaced on Item — re-introduced in a later phase.
enum ConditionGrade {
  A
  B
  C
  RETIRED
}

// LocationType is kept in the schema for future planning — it's no longer
// surfaced anywhere because Item now stores its locations as free text.
enum LocationType {
  WAREHOUSE
  AISLE
  RACK
  BIN
  VEHICLE
}

enum ItemStatus {
  AVAILABLE
  ALLOCATED
}

enum KitType {
  TEMPLATE
  CUSTOMER
}

enum KitStatus {
  DRAFT
  READY
  DEPLOYED
  RETIRED
}

enum AllocationStatus {
  RESERVED_ON_SALE
  RESERVED
  OUT
  RETURNED
  SHORT
  MISSING
}

enum ReplacementResolution {
  REPAIR
  REPLACE_FROM_STOCK
  PURCHASE_ORDER
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  RETIRED
}

enum SyncStatus {
  PENDING
  PROCESSED
  FAILED
}

// ---------- Core ----------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  role          Role     @default(USER)
  jobberUserId  String?  @unique
  active        Boolean  @default(true)
  passwordHash  String?
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  allocations          Allocation[]         @relation("AllocatedBy")
  flaggedReplacements  ReplacementQueue[]   @relation("FlaggedBy")
  resolvedReplacements ReplacementQueue[]   @relation("ResolvedBy")
  openedTickets        MaintenanceTicket[]  @relation("OpenedBy")
  auditEntries         AuditLog[]
  jobberConnections    JobberConnection[]
}

// Single-tenant Jobber OAuth connection. There should only be zero or one
// row in this table at any time — the admin disconnects to wipe and
// reconnect. Tokens are stored in plain text; acceptable for the trust
// model of an internal single-franchise app, revisit before multi-tenant.
model JobberConnection {
  id              String   @id @default(cuid())
  jobberAccountId String?
  accountName     String?
  accessToken     String
  refreshToken    String
  expiresAt       DateTime
  scopes          String[] @default([])
  connectedById   String?
  connectedBy     User?    @relation(fields: [connectedById], references: [id])
  connectedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Item is the master inventory record. As of the latest revision it's
// flat — description, product type, and locations are stored inline as
// text/enums rather than as relations. Per-unit serial tracking, kits,
// and a structured Location catalog will return in later phases.
model Item {
  id                       String         @id @default(cuid())
  sku                      String?

  name                     String
  description              String

  manufacturer             String?
  model                    String?

  productType              ProductType?

  status                   ItemStatus     @default(AVAILABLE)
  active                   Boolean        @default(true)
  quantity                 Int            @default(0)
  /// Low-stock threshold. Items with quantity <= minQuantity surface on the dashboard.
  minQuantity              Int            @default(0)
  unitCost                 Decimal?       @db.Decimal(12, 2) @map("purchaseCost")

  homeLocation             String?
  currentLocation          String?

  purchaseDate             DateTime?

  // Lifecycle, retirement, photos, and custom fields are kept in the
  // schema so later phases can light them up without another migration,
  // but they're not on the form right now.
  lifecycleType            LifecycleType?
  retirementMaxSeasons     Int?
  retirementMaxRepairs     Int?
  retirementConditionFloor ConditionGrade?

  seasonsDeployed          Int            @default(0)
  repairCount              Int            @default(0)
  retirementStatus         String?

  photos                   String[]       @default([])
  websites                 String[]       @default([])
  customFields             Json?

  jobberProductId          String?        @unique

  kitMemberships           KitItem[]
  allocations              Allocation[]
  jobLineItems             JobLineItem[]
  replacementEntries       ReplacementQueue[]
  maintenanceTickets       MaintenanceTicket[]

  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
}

model Kit {
  id              String     @id @default(cuid())
  name            String
  description     String     @default("")
  sku             String?
  manufacturer    String?
  model           String?
  productType     ProductType?
  unitCost        Decimal?   @db.Decimal(12, 2)
  active          Boolean    @default(true)
  kitType         KitType?
  status          ItemStatus @default(AVAILABLE)
  quantity        Int        @default(0)

  clientId        String?
  client          Client?    @relation(fields: [clientId], references: [id])
  propertyId      String?
  property        Property?  @relation(fields: [propertyId], references: [id])

  // Home location is now free text, matching Item. Was a relation to the
  // dropped Location model.
  homeLocation    String?
  currentLocation String?

  photos          String[]   @default([])

  jobberProductId String?    @unique

  items           KitItem[]
  allocations     Allocation[]
  jobLineItems    JobLineItem[]

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model KitItem {
  kitId    String
  itemId   String
  quantity Int    @default(1)

  kit      Kit    @relation(fields: [kitId], references: [id], onDelete: Cascade)
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([kitId, itemId])
}

// ---------- Jobber-mirrored ----------

model Client {
  id              String     @id @default(cuid())
  jobberClientId  String     @unique

  // Display name derived during sync from companyName || "firstName lastName".
  // Kept as a single column so list views can sort and search uniformly.
  name            String

  // Identity fields — exactly the set requested for sync from Jobber.
  firstName       String?
  lastName        String?
  companyName     String?
  emails          String[]   @default([])
  phones          String[]   @default([])
  tags            String[]   @default([])

  // Service address — denormalized from the customer's primary property
  // so the customer card can display it without a join.
  serviceStreet1  String?
  serviceCity     String?
  serviceState    String?
  serviceCountry  String?
  serviceZip      String?

  properties      Property[]
  jobs            JobberJob[]
  kits            Kit[]
  notes           JobberNote[]

  syncedAt        DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Property {
  id                String      @id @default(cuid())
  jobberPropertyId  String      @unique
  clientId          String
  client            Client      @relation(fields: [clientId], references: [id])
  address           String

  jobs              JobberJob[]
  kits              Kit[]

  syncedAt          DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model JobberJob {
  id            String         @id @default(cuid())
  jobberJobId   String         @unique

  title         String?
  jobNumber     String?
  description   String?
  instructions  String?
  total         Decimal?       @db.Decimal(12, 2)
  startAt       DateTime?
  endAt         DateTime?

  clientId      String
  client        Client         @relation(fields: [clientId], references: [id])
  propertyId    String?
  property      Property?      @relation(fields: [propertyId], references: [id])
  status        String

  visits        JobberVisit[]
  notes         JobberNote[]
  lineItems     JobLineItem[]

  syncedAt      DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// A single line on a Jobber Job. Each line is either a Product (mapped to
// Item) or a Service (mapped to Kit). If we can't resolve to a local row
// (deleted product, brand-new product not synced yet), we keep the raw
// name as a fallback so the Pick List still has something to show.
model JobLineItem {
  id               String      @id @default(cuid())
  jobberLineItemId String?     @unique
  jobId            String
  job              JobberJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)

  itemId           String?
  item             Item?       @relation(fields: [itemId], references: [id])
  kitId            String?
  kit              Kit?        @relation(fields: [kitId], references: [id])

  rawName          String?

  quantity         Decimal     @default(1) @db.Decimal(12, 2)
  notes            String?
  position         Int?

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([jobId])
  @@index([itemId])
  @@index([kitId])
}

model JobberVisit {
  id            String       @id @default(cuid())
  jobberVisitId String       @unique
  jobId         String
  job           JobberJob    @relation(fields: [jobId], references: [id])

  title         String?
  instructions  String?
  startAt       DateTime?
  endAt         DateTime?
  status        String

  allocations   Allocation[]
  notes         JobberNote[]

  syncedAt      DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model JobberNote {
  id            String        @id @default(cuid())
  jobberNoteId  String        @unique
  body          String
  isInternal    Boolean       @default(false)
  noteCreatedAt DateTime?

  // A note belongs to exactly one parent (client, job, or visit).
  clientId      String?
  client        Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  jobId         String?
  job           JobberJob?    @relation(fields: [jobId], references: [id], onDelete: SetNull)
  visitId       String?
  visit         JobberVisit?  @relation(fields: [visitId], references: [id], onDelete: SetNull)

  syncedAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([clientId])
  @@index([jobId])
  @@index([visitId])
}

// ---------- Vehicles, allocations, maintenance ----------

model Vehicle {
  id                 String        @id @default(cuid())
  name               String
  plate              String?
  vin                String?       @unique
  make               String?
  model              String?
  year               Int?
  capacity           String?
  registrationExp    DateTime?
  insuranceExp       DateTime?
  odometer           Int?
  status             String?
  photos             String[]      @default([])

  allocations        Allocation[]

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model Allocation {
  id                 String           @id @default(cuid())
  kitId              String?
  kit                Kit?             @relation(fields: [kitId], references: [id])
  itemId             String?
  item               Item?            @relation(fields: [itemId], references: [id])
  jobberVisitId      String?
  jobberVisit        JobberVisit?     @relation(fields: [jobberVisitId], references: [id])
  vehicleId          String?
  vehicle            Vehicle?         @relation(fields: [vehicleId], references: [id])

  allocatedAt        DateTime         @default(now())
  checkedOutAt       DateTime?
  checkedInAt        DateTime?
  allocatedByUserId  String?
  allocatedBy        User?            @relation("AllocatedBy", fields: [allocatedByUserId], references: [id])

  seasonId           String?
  season             Season?          @relation(fields: [seasonId], references: [id])

  status             AllocationStatus @default(RESERVED)

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model Season {
  id          String        @id @default(cuid())
  name        String        @unique
  startDate   DateTime
  endDate     DateTime
  allocations Allocation[]
}

model ReplacementQueue {
  id                 String                 @id @default(cuid())
  itemId             String
  item               Item                   @relation(fields: [itemId], references: [id])
  reason             String
  flaggedAt          DateTime               @default(now())
  flaggedByUserId    String?
  flaggedBy          User?                  @relation("FlaggedBy", fields: [flaggedByUserId], references: [id])
  resolution         ReplacementResolution?
  poId               String?
  resolvedAt         DateTime?
  resolvedByUserId   String?
  resolvedBy         User?                  @relation("ResolvedBy", fields: [resolvedByUserId], references: [id])
}

model MaintenanceTicket {
  id            String            @id @default(cuid())
  itemId        String
  item          Item              @relation(fields: [itemId], references: [id])
  openedAt      DateTime          @default(now())
  openedByUserId String?
  openedBy      User?             @relation("OpenedBy", fields: [openedByUserId], references: [id])
  status        MaintenanceStatus @default(OPEN)
  description   String
  photos        String[]          @default([])
  partsUsed     Json?
  laborMinutes  Int?
  closedAt      DateTime?
}

// ---------- Audit + sync + custom fields ----------

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String
  entityType  String
  entityId    String
  beforeJson  Json?
  afterJson   Json?
  ip          String?
  userAgent   String?
  occurredAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([occurredAt])
}

model SyncEvent {
  id           String     @id @default(cuid())
  source       String     @default("jobber")
  eventType    String
  payload      Json
  processedAt  DateTime?
  status       SyncStatus @default(PENDING)
  error        String?
  createdAt    DateTime   @default(now())

  @@index([status, createdAt])
}

model CustomFieldDef {
  id         String                @id @default(cuid())
  appliesTo  String
  name       String
  type       String
  options    Json?
  values     CustomFieldValue[]

  @@unique([appliesTo, name])
}

model CustomFieldValue {
  entityType  String
  entityId    String
  fieldDefId  String
  fieldDef    CustomFieldDef @relation(fields: [fieldDefId], references: [id], onDelete: Cascade)
  value       Json

  @@id([entityType, entityId, fieldDefId])
  @@index([entityType, entityId])
}
