# Copy this file to .env and fill in real values.
# .env is gitignored; never commit real secrets.

# Railway Postgres connection string. Use DATABASE_PUBLIC_URL from
# Railway -> santas-stock-dev service -> Variables tab.
DATABASE_URL="postgresql://user:password@host:port/database"

# Secret used by NextAuth to sign session tokens.
# Generate one with PowerShell:
#   -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 64 | ForEach-Object {[char]$_})
AUTH_SECRET="replace-with-a-long-random-string"

# Initial admin user, created by `npm run db:seed`.
SEED_ADMIN_EMAIL="you@example.com"
SEED_ADMIN_PASSWORD="pick-a-strong-password"
SEED_ADMIN_NAME="John"
